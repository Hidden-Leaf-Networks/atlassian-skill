# ============================================================================
# Atlassian Cloud Configuration
# ============================================================================
# Your Atlassian Cloud ID — REQUIRED for scoped API tokens (post-May 2026)
# Scoped tokens MUST route through api.atlassian.com/ex/jira/{cloudId}/...
# They will 401 on the site URL directly.
# To find: curl https://your-domain.atlassian.net/_edge/tenant_info
ATLASSIAN_CLOUD_ID=

# Your Atlassian site URL (no trailing slash)
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net

# ============================================================================
# Authentication (Choose one method)
# ============================================================================

# --- Option 1: Scoped API Token (Required since May 2026) ---
# Classic unscoped tokens expired May 2026. Create scoped tokens at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# IMPORTANT: Scoped tokens only work through the API gateway, not the site URL.
# The skill handles this automatically when ATLASSIAN_CLOUD_ID is set.
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=

# --- Option 2: OAuth 2.0 (Recommended for production) ---
# Register an OAuth app at: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3000/callback
ATLASSIAN_ACCESS_TOKEN=
ATLASSIAN_REFRESH_TOKEN=

# OAuth token metadata (managed automatically, rarely set manually)
# ATLASSIAN_TOKEN_EXPIRY=
# ATLASSIAN_TOKEN_SCOPE=

# ============================================================================
# Bitbucket Authentication
# ============================================================================
# Bitbucket uses SEPARATE auth from Jira/Confluence.
#
# --- Option 1: Atlassian API Token with Bitbucket scopes (Recommended) ---
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# Scopes needed: read/write/admin:repository:bitbucket, read/write:pullrequest:bitbucket
# Uses ATLASSIAN_USER_EMAIL from above as the username.
BITBUCKET_API_TOKEN=

# --- Legacy App Password (REMOVED by Atlassian July 28, 2026) ---
# No longer available. Use scoped API token or OAuth instead.

# --- Option 3: OAuth 2.0 ---
# BITBUCKET_ACCESS_TOKEN=
# BITBUCKET_REFRESH_TOKEN=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# ============================================================================
# Project Defaults
# ============================================================================
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=
CONFLUENCE_SPACE_KEY=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=

# ============================================================================
# Rate Limiting
# ============================================================================
# RATE_LIMIT_POINTS_PER_HOUR=65000
# RATE_LIMIT_REQUESTS_PER_SECOND=10

# ============================================================================
# Session Capture
# ============================================================================
SESSION_CAPTURE_ENABLED=true
SESSION_CAPTURE_MODE=full
SESSION_AUTO_ARCHIVE=false

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
